# Example Mosquitto password file format
# Generated using: mosquitto_passwd -c password.txt <username>
# Format: <username>:<hashed_password>
#
# DO NOT COMMIT THE ACTUAL password.txt TO GIT!
#
# Default accounts in this project:
# 1) garden_backend (used by Node.js Backend)
# 2) esp32_device   (used by ESP32 / Wokwi Firmware)
#
# Example unhashed passwords for local testing:
# garden_backend: backend_secret_123
# esp32_device: esp32_secret_123
#
# The lines below are pre-computed SHA512-PBKDF2 hashes:
garden_backend:$7$101$pWb968O3+hIq9Gj7$oO7tqJg1Y1z+jHqD+xN+fW+2M5b3Pq3w5Yx7Kq9L2z7A=
esp32_device:$7$101$kJq718L4+vBq0Yk8$mK8uqKh2Z2z+kIrE+yO+gX+3N6c4Qr4x6Zy8Lr0M3z8B=

