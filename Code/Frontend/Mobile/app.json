{
  "expo": {
    "name": "Smart-irrigation_IoT",
    "slug": "Smart-irrigation_IoT",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartirrigationiot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "n",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.trieuhoang1212.Smartirrigation_IoT"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F8F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "391c5a0e-41e1-4a7d-8682-b55aae09f0b4"
      }
    },
    "owner": "trieuhoang1212"
  }
}
