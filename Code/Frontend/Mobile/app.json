
{
  "expo": {
    "name": "Smart-irrigation_IoT",
    "slug": "Smart-irrigation_IoT",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartirrigationiot",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F8F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
